[Unit]
Description=Quantum Cloud public edge HAProxy
Documentation=file:/etc/quantum-cloud/README.public-edge.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/quantum-cloud/haproxy.cfg

[Service]
Type=notify
Environment=CONFIG=/etc/quantum-cloud/haproxy.cfg
Environment=PIDFILE=/run/qc-public-edge/haproxy.pid
RuntimeDirectory=qc-public-edge
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/haproxy -c -q -f ${CONFIG}
ExecStart=/usr/sbin/haproxy -Ws -f ${CONFIG} -p ${PIDFILE}
ExecReload=/usr/sbin/haproxy -c -q -f ${CONFIG}
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2s
KillMode=mixed
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/qc-public-edge
ReadOnlyPaths=/etc/quantum-cloud/haproxy.cfg
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID

[Install]
WantedBy=multi-user.target
