{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "mysql", "redis", "kafka", "minio"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["namespace", "storageClassName", "nodePlacement"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
        "nodePlacement": {
          "type": "object",
          "required": ["data", "web"],
          "properties": {
            "data": { "type": "object" },
            "web": { "type": "object" }
          }
        }
      }
    },
    "mysql": {
      "type": "object",
      "required": ["name", "version", "storage", "rootExistingSecret", "appCredentialsSecret", "schemas"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "rootExistingSecret": { "type": "string", "minLength": 1 },
        "appCredentialsSecret": { "type": "string", "minLength": 1 },
        "schemas": { "type": "object", "minProperties": 4 }
      }
    },
    "kafka": {
      "type": "object",
      "required": ["name", "image", "storage", "clusterId", "retentionBudgetBytes", "topics"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "clusterId": { "type": "string", "minLength": 1 },
        "retentionBudgetBytes": { "type": "integer", "minimum": 1 },
        "topics": { "type": "object", "minProperties": 1 }
      }
    },
    "redis": { "type": "object" },
    "minio": { "type": "object" },
    "backup": { "type": "object" }
  }
}

